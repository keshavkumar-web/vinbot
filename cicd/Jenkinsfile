// Jenkinsfile — VinBot CI/CD, Docker-based deployment (replaces systemd/v1)
//
// Flow: checkout -> gate on GitHub Actions having already passed for this
// commit -> build the Docker image once -> tag it (immutable SHA + moving
// "dev" tag) -> push both to GHCR -> SSH to the Ubuntu deployment server ->
// `docker compose pull` + `up -d` the SHA tag -> wait for health -> verify
// /api/health -> validate -> cleanup. Any failure from "pull" onward
// triggers an automatic rollback to the image that was running before this
// build started, and the Jenkins build is marked FAILED regardless of
// whether the rollback itself succeeds.
//
// Architecture (agreed in chat, not re-litigated here):
//   - Option B: build once in Jenkins, push to a registry, deploy servers
//     only ever PULL. Never build source on the deployment server.
//   - GitHub Actions remains the ONLY place unit/integration/smoke/Newman
//     tests run. This pipeline does not install pytest anywhere and does
//     not re-run those suites — it GATES on their result for this exact
//     commit via GitHub's Checks API before building anything.
//   - Auth to the Ubuntu box: the Jenkins Credential `vinbot-deploy-key`
//     (SSH Username with private key), loaded via the SSH Agent plugin's
//     `sshagent` step inside runRemote()/runRemoteCapture() below — NOT the
//     Jenkins OS user's own key file anymore (that was the v1/early-v2
//     model; superseded once a dedicated deploy-key credential existed).
//   - Registry (GHCR) and the GitHub Checks API both authenticate with ONE
//     Jenkins Credential (a GitHub PAT with `write:packages`, `read:packages`,
//     and `repo` scopes) — see GHCR_CREDENTIALS_ID below.
//
// Deployment target values (DEV_SSH_HOST / DEV_SSH_USER) are hardcoded
// directly in this file's `environment {}` block — see the comment above
// DEV_SSH_PORT below for why (Jenkins-level global environment variables
// were tried first and never actually populated on this instance).
//
// New Jenkins prerequisites this version introduces (none of these existed
// for v1 — see chat for the full explanation):
//   - Docker Engine installed on the JENKINS AGENT ITSELF (it now builds
//     images locally, not just orchestrates SSH).
//   - Two new plugins: HTTP Request Plugin (`httpRequest` step) and
//     Pipeline Utility Steps (`readJSON` step) — used only for the GitHub
//     Actions gate, nothing else in this file needs them.
//   - SSH Agent Plugin (`sshagent` step) — used only inside
//     runRemote()/runRemoteCapture() below, nowhere else in this file.
//   - A Jenkins Credential `vinbot-deploy-key` (SSH Username with private
//     key: username = ecadmin, private key = the deploy key already
//     trusted for passwordless SSH on the Ubuntu deployment box).
//   - A Jenkins Credential `github-pat` (Username with password:
//     username = GitHub user, password = PAT as described above).
//   - A Jenkins Credential (Secret text) holding OPENAI_API_KEY — see the
//     note above the credential's use below; this pipeline does NOT write
//     it anywhere itself (backend/.env on the deploy server is assumed to
//     already exist and already contain it, per your stated assumption
//     that "the compose file and .env already exist on the deployment
//     server" — if that ever needs to change, this is the stage to revisit).

def sshExec(String remoteCmd) {
    // Same centralizing helper as v1 — one place for connection options.
    return "ssh -p ${env.DEV_SSH_PORT} -o BatchMode=yes -o ConnectTimeout=10 " +
           "-o ServerAliveInterval=15 ${env.DEV_SSH_USER}@${env.DEV_SSH_HOST} '${remoteCmd}'"
}

def runRemote(String remoteCmd) {
    // Fire-and-check a remote command; fails the calling step on non-zero exit.
    // sshagent loads the 'vinbot-deploy-key' credential's private key into a
    // per-step ssh-agent for the duration of this block only — sshExec()'s
    // plain `ssh ...` call then authenticates against it automatically,
    // with no -i flag or key path needed.
    sshagent(credentials: ['vinbot-deploy-key']) {
        sh "#!/usr/bin/env bash\nset -euo pipefail\n" + sshExec(remoteCmd)
    }
}

def runRemoteCapture(String remoteCmd) {
    // Same, but returns stdout (trimmed) instead of just pass/fail. The
    // sshagent step itself returns whatever its block evaluates to, so
    // `return` here propagates the captured/trimmed stdout out of
    // runRemoteCapture() exactly as before this credential was added.
    return sshagent(credentials: ['vinbot-deploy-key']) {
        sh(
            script: "#!/usr/bin/env bash\nset -euo pipefail\n" + sshExec(remoteCmd),
            returnStdout: true
        ).trim()
    }
}

def copyComposeFile() {
    // docker-compose.yml lives in this repo (checked out onto the Jenkins
    // agent by the Checkout stage) but COMPOSE_DIR on the deployment server
    // was never actually populated with it — that was previously an
    // assumed out-of-band step that never happened, which is why
    // `docker compose pull` failed with "no configuration file provided".
    // Copied fresh on every deploy so the server always runs whatever
    // version of the file is in the commit being deployed. Uses the same
    // 'vinbot-deploy-key' credential as every other SSH/SCP operation here.
    sshagent(credentials: ['vinbot-deploy-key']) {
        sh """
            set -euo pipefail
            scp -P ${env.DEV_SSH_PORT} -o BatchMode=yes -o ConnectTimeout=10 \\
                docker-compose.yml ${env.DEV_SSH_USER}@${env.DEV_SSH_HOST}:${env.COMPOSE_DIR}/docker-compose.yml
        """
    }
}

def composeUp(String imageTag) {
    // IMAGE_TAG is exported for THIS remote shell only — it's what
    // docker-compose.yml's `image: ghcr.io/keshavkumar-web/vinbot:${IMAGE_TAG:-dev}`
    // resolves against. Pulls before starting so a partially-cached/stale
    // local layer can never be silently reused.
    runRemote("cd ${env.COMPOSE_DIR} && export IMAGE_TAG=${imageTag} && " +
               "docker compose pull && docker compose up -d")
}

def waitForHealthy(int maxAttempts, int delaySeconds) {
    // Polls Docker's OWN HEALTHCHECK verdict (from the Dockerfile's
    // HEALTHCHECK instruction) rather than re-implementing health logic
    // here. Returns false (never throws) so the caller decides what
    // "still unhealthy after waiting" means — deploy failure vs rollback
    // failure are handled differently by the two call sites below.
    for (int i = 1; i <= maxAttempts; i++) {
        def status = ''
        try {
            status = runRemoteCapture("docker inspect --format='{{.State.Health.Status}}' vinbot")
        } catch (ignored) {
            status = 'container-not-found'
        }
        echo "Health poll ${i}/${maxAttempts}: ${status}"
        if (status == 'healthy') {
            return true
        }
        if (i < maxAttempts) {
            sleep(time: delaySeconds, unit: 'SECONDS')
        }
    }
    return false
}

def verifyHealthEndpoint() {
    // Independent, belt-and-suspenders confirmation on top of Docker's own
    // HEALTHCHECK verdict — a direct curl from the deployment server
    // itself against localhost, exactly like v1's Health Check stage.
    runRemote("curl -fsS --max-time 5 http://localhost:${env.HOST_PORT}/api/health")
}

pipeline {
    agent any

    options {
        timestamps()
        timeout(time: 45, unit: 'MINUTES')   // generous: the GH Actions gate alone can wait up to 15 min
        disableConcurrentBuilds()
        buildDiscarder(logRotator(numToKeepStr: '20'))
    }

    environment {
        // --- Container registry (GHCR) ---
        REGISTRY = 'ghcr.io'
        IMAGE_NAME = 'keshavkumar-web/vinbot'
        MOVING_TAG = 'dev'
        // Jenkins Credential (Username with password): username = GitHub
        // user, password = a PAT scoped write:packages + read:packages +
        // repo. Used for BOTH `docker login ghcr.io` and the GitHub Checks
        // API call below — one credential, two uses, per the architecture
        // agreed in chat. Split into two credentials if you'd rather keep
        // registry and API-read privileges separate.
        GHCR_CREDENTIALS_ID = 'github-pat'

        // --- GitHub (for gating deploys on Actions results) ---
        GITHUB_OWNER = 'keshavkumar-web'
        GITHUB_REPO = 'vinbot'
        // Must exactly match the `name:` fields of the jobs in
        // .github/workflows/test.yml — if that file's job names ever
        // change, update this list to match.
        GH_REQUIRED_CHECKS = 'Generate knowledge_db.pkl,Unit + Integration Tests (pytest),Smoke Tests,API Integration Tests (Newman)'

        // --- Ubuntu 22.04 LTS deployment target ---
        // DEV_SSH_HOST / DEV_SSH_USER were previously left unassigned here,
        // sourced instead from Jenkins-level (global/job) environment
        // variables — that config was never actually populated on this
        // Jenkins instance, so env.DEV_SSH_HOST/env.DEV_SSH_USER resolved
        // to null at runtime (`scp ... null@null:...`, `ssh: Could not
        // resolve hostname null`). Hardcoded directly here instead so they
        // always resolve correctly regardless of Jenkins-level config.
        DEV_SSH_HOST = '192.168.36.51'
        DEV_SSH_USER = 'ecadmin'
        DEV_SSH_PORT = '69'
        // Directory on the Ubuntu server containing docker-compose.yml and
        // backend/.env — assumed (per your instruction) to already exist.
        COMPOSE_DIR  = '/opt/vinbot'
        // Assumes the SSH user is in the local `docker` group (passwordless
        // docker/docker-compose access — the standard post-install step in
        // Docker's own Ubuntu documentation: `sudo usermod -aG docker
        // <user>`). If your box instead requires `sudo -n docker ...`,
        // every `docker`/`docker compose` command built inside
        // sshExec()'s callers below needs a `sudo -n ` prefix added —
        // flagged here rather than guessed at silently.
        //
        // Firewall: if HOST_PORT needs to be reachable from outside the
        // box, Ubuntu uses ufw, not firewalld — e.g.
        // `sudo ufw allow 38005/tcp`. Not run by this pipeline (per your
        // instruction, configured separately); mentioned here only so the
        // right tool is used if/when it's needed.
        HOST_PORT = '38005'

        DEPLOY_BRANCH = 'main'
    }

    stages {

        // ---------------------------------------------------------------
        // 1. Checkout — also computes the two full image references
        //    (immutable SHA tag + moving tag) as soon as GIT_COMMIT is
        //    known, so every later stage just reads env.IMAGE_SHA_TAG /
        //    env.IMAGE_MOVING_TAG rather than recomputing them.
        // ---------------------------------------------------------------
        stage('Checkout') {
            steps {
                echo "START: Checkout"
                checkout scm
                script {
                    env.IMAGE_SHA_TAG    = "${env.REGISTRY}/${env.IMAGE_NAME}:${env.GIT_COMMIT}"
                    env.IMAGE_MOVING_TAG = "${env.REGISTRY}/${env.IMAGE_NAME}:${env.MOVING_TAG}"
                }
                echo "SUCCESS: Checkout commit ${env.GIT_COMMIT} (branch: ${env.GIT_BRANCH ?: env.DEPLOY_BRANCH})"
            }
        }

        // ---------------------------------------------------------------
        // 2. Verify GitHub Actions Tests Passed — the gate that REPLACES
        //    running pytest/smoke/Newman inside Jenkins. GitHub Actions is
        //    the single source of truth for test results; this stage
        //    polls the Checks API for this exact commit SHA and refuses
        //    to build/deploy anything until every required job shows
        //    conclusion=success. Fails CLOSED: missing/incomplete/failed
        //    checks all block the deploy, same as an actual test failure
        //    would.
        //
        //    Implemented as ONE consolidated stage (one API call per poll,
        //    checking all 4 required jobs at once) rather than one Jenkins
        //    stage per job — fewer GitHub API round-trips, one atomic
        //    pass/fail. Split it into separate stages if you want each
        //    job's result visible as its own entry in the Stage View;
        //    functionally identical either way.
        // ---------------------------------------------------------------
        stage('Verify GitHub Actions Tests Passed') {
            options {
                timeout(time: 15, unit: 'MINUTES')
            }
            steps {
                echo "START: Verify GitHub Actions Tests Passed"
                script {
                    def expectedJobs = env.GH_REQUIRED_CHECKS.split(',') as List
                    def delaySeconds = 30
                    def maxAttempts = 30   // 30 * 30s = 15 minutes, matches the stage timeout above
                    def allDone = false
                    def checkRuns = [:]

                    withCredentials([usernamePassword(credentialsId: env.GHCR_CREDENTIALS_ID,
                                                       usernameVariable: 'GH_USER', passwordVariable: 'GH_TOKEN')]) {
                        for (int attempt = 1; attempt <= maxAttempts; attempt++) {
                            def response = httpRequest(
                                url: "https://api.github.com/repos/${env.GITHUB_OWNER}/${env.GITHUB_REPO}/commits/${env.GIT_COMMIT}/check-runs",
                                customHeaders: [
                                    [name: 'Authorization', value: "Bearer ${GH_TOKEN}", maskValue: true],
                                    [name: 'Accept', value: 'application/vnd.github+json'],
                                ],
                                validResponseCodes: '100:599',
                            )
                            if (response.status != 200) {
                                echo "GitHub API returned HTTP ${response.status} (attempt ${attempt}/${maxAttempts}) — retrying in ${delaySeconds}s..."
                                sleep(time: delaySeconds, unit: 'SECONDS')
                                continue
                            }

                            def json = readJSON(text: response.content)
                            checkRuns = [:]
                            json.check_runs.each { run -> checkRuns[run.name] = [status: run.status, conclusion: run.conclusion] }

                            def pending = expectedJobs.findAll { name -> !checkRuns.containsKey(name) || checkRuns[name].status != 'completed' }
                            if (pending.isEmpty()) {
                                allDone = true
                                break
                            }
                            echo "Waiting on GitHub Actions job(s): ${pending.join(', ')} (attempt ${attempt}/${maxAttempts})"
                            sleep(time: delaySeconds, unit: 'SECONDS')
                        }
                    }

                    if (!allDone) {
                        currentBuild.result = 'FAILURE'
                        error("FAILURE: Verify GitHub Actions Tests Passed — checks for commit ${env.GIT_COMMIT} did not all complete within 15 minutes.")
                    }

                    def failed = expectedJobs.findAll { name -> checkRuns[name].conclusion != 'success' }
                    if (!failed.isEmpty()) {
                        currentBuild.result = 'FAILURE'
                        error("FAILURE: Verify GitHub Actions Tests Passed — " +
                              failed.collect { "${it}=${checkRuns[it].conclusion}" }.join(', '))
                    }

                    echo "SUCCESS: Verify GitHub Actions Tests Passed — all required checks green for ${env.GIT_COMMIT}"
                }
            }
        }

        // ---------------------------------------------------------------
        // TEMPORARY — Docker Environment Diagnostics. Added to debug
        // "BuildKit is enabled but the buildx component is missing or
        // broken" failing only inside the Jenkins pipeline (not under an
        // interactive `sudo -u jenkins` shell). Safe to remove once the
        // root cause (Jenkins process env vs. interactive shell env) is
        // confirmed and the fix below is verified in production.
        // ---------------------------------------------------------------
        stage('Docker Environment Diagnostics') {
            steps {
                echo "START: Docker Environment Diagnostics"
                sh '''
                    whoami
                    pwd
                    echo "HOME=$HOME"
                    echo "PATH=$PATH"
                    which docker
                    docker --version
                    docker buildx version
                    docker info
                    env | sort
                '''
                echo "SUCCESS: Docker Environment Diagnostics"
            }
        }

        // ---------------------------------------------------------------
        // 3. Build Docker Image — built ONCE, here, and nowhere else.
        //    GIT_COMMIT/BUILD_DATE build-args feed the Dockerfile's own
        //    ARG/LABEL instructions from Step 1, so the resulting image
        //    carries traceable provenance metadata.
        //
        //    HOME is pinned explicitly (rather than left to whatever the
        //    Jenkins service's own process environment provides) because
        //    Docker's buildx plugin/config resolution differs between an
        //    interactive `sudo -u jenkins` shell (which sets HOME to the
        //    jenkins user's home) and the Jenkins agent's own systemd-
        //    launched environment (which may not). Confirm /var/lib/jenkins
        //    is this box's actual jenkins home via the diagnostics stage
        //    above (`env | sort` -> HOME, or `getent passwd jenkins`)
        //    before relying on this value.
        //
        //    `docker buildx build` is invoked explicitly instead of
        //    `DOCKER_BUILDKIT=1 docker build` — the implicit env-var
        //    delegation is exactly what's failing; calling buildx directly
        //    removes that indirection. `--load` is required because the
        //    default buildx "docker" driver auto-loads into the local
        //    image store, but that's not guaranteed for every builder/
        //    driver combination — the next two stages (Tag, Push) both
        //    require the image to already exist in `docker images`.
        // ---------------------------------------------------------------
        stage('Build Docker Image') {
            steps {
                echo "START: Build Docker Image"
                sh """
                    set -euo pipefail
                    export HOME=/var/lib/jenkins
                    BUILD_DATE=\$(date -u +%Y-%m-%dT%H:%M:%SZ)
                    docker buildx build \\
                        --load \\
                        --build-arg GIT_COMMIT=${env.GIT_COMMIT} \\
                        --build-arg BUILD_DATE=\$BUILD_DATE \\
                        -t ${env.IMAGE_SHA_TAG} \\
                        .
                """
                echo "SUCCESS: Build Docker Image (${env.IMAGE_SHA_TAG})"
            }
        }

        // ---------------------------------------------------------------
        // 4. Tag Image — adds the moving tag to the SAME image built
        //    above (no rebuild). The SHA tag is the immutable artifact;
        //    the moving tag is just a second pointer to those same bytes.
        // ---------------------------------------------------------------
        stage('Tag Image') {
            steps {
                echo "START: Tag Image"
                sh "docker tag ${env.IMAGE_SHA_TAG} ${env.IMAGE_MOVING_TAG}"
                echo "SUCCESS: Tag Image (${env.IMAGE_MOVING_TAG} -> ${env.IMAGE_SHA_TAG})"
            }
        }

        // ---------------------------------------------------------------
        // 5. Push Image to GHCR — both tags. The deployment server will
        //    never see a `docker build`; this is the only place the image
        //    leaves the Jenkins agent.
        // ---------------------------------------------------------------
        stage('Push Image to GHCR') {
            steps {
                echo "START: Push Image to GHCR"
                withCredentials([usernamePassword(credentialsId: env.GHCR_CREDENTIALS_ID,
                                                   usernameVariable: 'GHCR_USER', passwordVariable: 'GHCR_TOKEN')]) {
                    sh '''
                        set -euo pipefail
                        echo "$GHCR_TOKEN" | docker login "$REGISTRY" -u "$GHCR_USER" --password-stdin
                    '''
                    sh "docker push ${env.IMAGE_SHA_TAG}"
                    sh "docker push ${env.IMAGE_MOVING_TAG}"
                    sh 'docker logout "$REGISTRY" || true'
                }
                echo "SUCCESS: Push Image to GHCR"
            }
        }

        // ---------------------------------------------------------------
        // 6. Deploy to Ubuntu Server — pull + start the new SHA tag over
        //    SSH, wait for health, verify the endpoint. ANY failure from
        //    here onward (pull fails, up fails, health never turns
        //    "healthy", the endpoint doesn't respond) triggers automatic
        //    rollback: stop the failed container, redeploy whatever image
        //    tag was running immediately before this build started
        //    (captured BEFORE touching anything, via `docker inspect` —
        //    never a rebuild, never a git operation, just re-pointing
        //    compose at an already-pushed, already-immutable tag), and
        //    re-verify health on the rolled-back version. The Jenkins
        //    build is marked FAILED in every failure path, including a
        //    SUCCESSFUL rollback — restoring the old version means the
        //    server is healthy again, but deploying the new commit still
        //    did not succeed, and that must show up as a failed build.
        // ---------------------------------------------------------------
        stage('Deploy to Ubuntu Server') {
            steps {
                echo "START: Deploy to Ubuntu Server"
                script {
                    def previousImage = ''
                    try {
                        previousImage = runRemoteCapture("docker inspect --format='{{.Config.Image}}' vinbot")
                    } catch (ignored) {
                        echo "No currently-running 'vinbot' container found (first-ever deploy?) — no rollback target will be available if this deploy fails."
                    }

                    try {
                        copyComposeFile()
                        composeUp(env.GIT_COMMIT)
                        if (!waitForHealthy(20, 3)) {
                            error("container did not report healthy within 60s")
                        }
                        verifyHealthEndpoint()
                        echo "SUCCESS: Deploy to Ubuntu Server (${env.IMAGE_SHA_TAG})"
                    } catch (deployErr) {
                        echo "FAILURE: Deploy to Ubuntu Server — ${deployErr.getMessage()}"

                        if (!previousImage) {
                            currentBuild.result = 'FAILURE'
                            error("Deployment of ${env.IMAGE_SHA_TAG} failed and there is no previous image to roll back to (first deploy). Manual intervention required.")
                        }

                        echo "START: Automatic rollback to ${previousImage}"
                        def previousTag = previousImage.tokenize(':').last()
                        try {
                            runRemote("cd ${env.COMPOSE_DIR} && export IMAGE_TAG=${env.GIT_COMMIT} && docker compose stop vinbot || true")
                            composeUp(previousTag)
                            if (!waitForHealthy(20, 3)) {
                                throw new Exception("rolled-back container did not report healthy within 60s")
                            }
                            verifyHealthEndpoint()
                            echo "SUCCESS: Automatic rollback to ${previousImage}"
                        } catch (rollbackErr) {
                            currentBuild.result = 'FAILURE'
                            error("CRITICAL — FAILURE: Automatic rollback also failed (${rollbackErr.getMessage()}). " +
                                  "Manual intervention required immediately. Last known good image: ${previousImage}")
                        }

                        currentBuild.result = 'FAILURE'
                        error("Deployment of ${env.IMAGE_SHA_TAG} failed and was automatically rolled back to ${previousImage}. Build marked FAILED.")
                    }
                }
            }
        }

        // ---------------------------------------------------------------
        // 7. Validate Deployment — the exact checks you asked for,
        //    against whatever is actually running now (the new version on
        //    the success path; the rolled-back version if stage 6 caught
        //    a failure and already exited — reached only when stage 6 did
        //    NOT error out, i.e. the new version really is healthy).
        // ---------------------------------------------------------------
        stage('Validate Deployment') {
            steps {
                echo "START: Validate Deployment"
                script {
                    runRemote("docker ps --filter name=vinbot")
                    runRemote("cd ${env.COMPOSE_DIR} && docker compose ps")
                    runRemote("docker inspect vinbot --format='Status={{.State.Status}} Health={{.State.Health.Status}} Image={{.Config.Image}}'")
                    runRemote("docker logs vinbot --tail 50")
                    verifyHealthEndpoint()
                }
                echo "SUCCESS: Validate Deployment"
            }
        }

        // ---------------------------------------------------------------
        // 8. Cleanup — `docker image prune` (no -a) and `docker builder
        //    prune` structurally CANNOT remove a tagged image, only truly
        //    dangling (untagged) layers and build cache. The currently
        //    running image and the previous rollback image are both
        //    tagged (vinbot:<sha>), so neither is ever at risk here —
        //    this isn't a filter I'm applying, it's what these commands
        //    are incapable of touching in the first place.
        // ---------------------------------------------------------------
        stage('Cleanup') {
            steps {
                echo "START: Cleanup"
                sh 'docker image prune -f'
                sh 'docker builder prune -f'
                script {
                    runRemote("docker image prune -f")
                }
                echo "SUCCESS: Cleanup (dangling images and build cache removed; tagged images untouched)"
            }
        }
    }

    post {
        success {
            echo "================================================================"
            echo " DEPLOYMENT SUCCESSFUL"
            echo "   Image           : ${env.IMAGE_SHA_TAG}"
            echo "   Moving tag      : ${env.IMAGE_MOVING_TAG}"
            echo "   Health endpoint : http://${env.DEV_SSH_HOST}:${env.HOST_PORT}/api/health -> 200 OK"
            echo "================================================================"
        }
        failure {
            echo "================================================================"
            echo " PIPELINE FAILED — see the failing stage above for the exact cause."
            echo "   If 'Deploy to Ubuntu Server' was reached, check its log for"
            echo "   whether automatic rollback succeeded or needs manual follow-up."
            echo "================================================================"
        }
        always {
            sh 'docker logout "$REGISTRY" || true'
            echo "Build #${env.BUILD_NUMBER} finished with status: ${currentBuild.currentResult}"
        }
    }
}
