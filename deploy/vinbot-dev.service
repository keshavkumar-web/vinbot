[Unit]
Description=Vinbot API (DEV — dev-vinbot.vinbox.in)
After=network.target

[Service]
User=vinbot-dev
Group=vinbot-dev
WorkingDirectory=/opt/vinbot-dev/backend
EnvironmentFile=/opt/vinbot-dev/backend/.env
# Single worker: sessions are stored in process memory (see app/sessions.py).
# Running multiple workers would split a user's chat history across processes.
ExecStart=/opt/vinbot-dev/backend/.venv/bin/uvicorn app.main:app \
          --host 127.0.0.1 --port 8010 --workers 1 --timeout-keep-alive 75
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
