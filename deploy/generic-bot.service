[Unit]
Description=UHBVN Assistant (FastAPI serving Vue build)
After=network.target

[Service]
Type=simple
# Run as a non-root user that owns the project directory.
User=botuser
Group=botuser

WorkingDirectory=/opt/generic_bot/backend

# Loads OPENAI_API_KEY (and any overrides) from backend/.env.
EnvironmentFile=/opt/generic_bot/backend/.env

# Bind port 80 directly. AmbientCapabilities lets the non-root process bind a
# privileged port without running as root. Use --port 8000 instead if you do
# not want port 80 (then reach the app at http://SERVER_IP:8000).
ExecStart=/opt/generic_bot/backend/.venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 80
AmbientCapabilities=CAP_NET_BIND_SERVICE

Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
