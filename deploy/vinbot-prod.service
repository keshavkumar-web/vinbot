[Unit]
Description=Vinbot API (PROD — vinbot.vinbox.in)
After=network.target

[Service]
User=vinbot-prod
Group=vinbot-prod
WorkingDirectory=/opt/vinbot-prod/backend
EnvironmentFile=/opt/vinbot-prod/backend/.env
# Single worker: sessions are stored in process memory (see app/sessions.py).
# Running multiple workers would split a user's chat history across processes.
ExecStart=/opt/vinbot-prod/backend/.venv/bin/uvicorn app.main:app \
          --host 127.0.0.1 --port 8000 --workers 1 --timeout-keep-alive 75
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
