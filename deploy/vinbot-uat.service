[Unit]
Description=Vinbot API (UAT — uat-vinbot.vinbox.in)
After=network.target

[Service]
User=vinbot-uat
Group=vinbot-uat
WorkingDirectory=/opt/vinbot-uat/backend
EnvironmentFile=/opt/vinbot-uat/backend/.env
# Single worker: sessions are stored in process memory (see app/sessions.py).
# Running multiple workers would split a user's chat history across processes.
ExecStart=/opt/vinbot-uat/backend/.venv/bin/uvicorn app.main:app \
          --host 127.0.0.1 --port 8020 --workers 1 --timeout-keep-alive 75
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
